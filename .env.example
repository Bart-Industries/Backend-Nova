APP_ENV=local
APP_PORT=8081
# PORT is injected automatically by Render when using Docker.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/starcafe
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=86400
CORS_ALLOWED_ORIGINS=http://localhost:8081
FRONTEND_BASE_URL=http://localhost:8081
BCRYPT_COST=12
APP_THREADS=4
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret
CLOUDINARY_FOLDER=nova/products
CLOUDINARY_BUSINESS_FOLDER=nova/businesses
MAX_PRODUCT_IMAGE_SIZE_MB=5
